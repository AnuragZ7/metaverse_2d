{
  "name": "ws",
  "version": "1.0.0",
  "description": "Distributed real-time gateway for SkyScope",
  "main": "dist/index.js",
  "scripts": {
    "build": "prisma generate && esbuild src/index.ts --bundle --platform=node --packages=external --outfile=dist/index.js --tsconfig=tsconfig.json",
    "check-types": "prisma generate && tsc --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "pnpm build && vitest run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/semantic-conventions": "^1.39.0",
    "@prisma/client": "^6.8.2",
    "esbuild": "^0.25.5",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "pino": "^10.3.0",
    "prom-client": "^15.1.3",
    "ws": "^8.18.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.16.5",
    "@types/ws": "^8.18.1",
    "prisma": "^6.8.2",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
